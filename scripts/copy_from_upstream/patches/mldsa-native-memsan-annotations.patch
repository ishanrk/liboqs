diff --git a/mldsa/src/sys.h b/mldsa/src/sys.h
--- a/mldsa/src/sys.h
+++ b/mldsa/src/sys.h
@@ -245,9 +245,27 @@
 #if defined(MLD_CONFIG_CT_TESTING_ENABLED) && !defined(__ASSEMBLER__)
+/* Valgrind client requests do not update MemorySanitizer's shadow memory. */
+#if defined(__has_feature)
+#if __has_feature(memory_sanitizer)
+#define MLD_CT_TESTING_MEMSAN
+#endif
+#endif
+
+#if defined(MLD_CT_TESTING_MEMSAN)
+#include <sanitizer/msan_interface.h>
+#define MLD_CT_TESTING_SECRET(ptr, len) __msan_poison((ptr), (len))
+#define MLD_CT_TESTING_DECLASSIFY(ptr, len) __msan_unpoison((ptr), (len))
+/* MemorySanitizer checks the inputs to inline assembly instead of tracking
+ * their shadow values. Use the volatile value barrier to preserve secrecy. */
+#if !defined(MLD_CONFIG_NO_ASM_VALUE_BARRIER)
+#define MLD_CONFIG_NO_ASM_VALUE_BARRIER
+#endif
+#else
 #include <valgrind/memcheck.h>
 #define MLD_CT_TESTING_SECRET(ptr, len) \
   VALGRIND_MAKE_MEM_UNDEFINED((ptr), (len))
 #define MLD_CT_TESTING_DECLASSIFY(ptr, len) \
   VALGRIND_MAKE_MEM_DEFINED((ptr), (len))
+#endif /* MLD_CT_TESTING_MEMSAN */
 #else /* MLD_CONFIG_CT_TESTING_ENABLED && !__ASSEMBLER__ */
 #define MLD_CT_TESTING_SECRET(ptr, len) \
   do                                    \
